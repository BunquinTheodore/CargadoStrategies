rules_version = '2';

// Cargado Strategies accounts (docs/setup-firebase.md, spec §8). Deploy with
//   firebase deploy --only firestore:rules
// The api/ functions use the service account, which bypasses these rules; they
// check roles themselves. Points, roles, bookings and records are written only
// there (or by the admin). Pages read their own data and edit their own profile.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isVerifiedEmail(email) {
      return signedIn() && request.auth.token.email_verified == true && email == request.auth.token.email.lower();
    }

    function isShortText(value, max) {
      return value is string && value.size() <= max;
    }

    // The profile fields a user may set on themselves. role, points, email and
    // the referral fields are fixed at sign-up or changed by the server only.
    function editableProfileOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'updatedAt'])
        && isShortText(request.resource.data.get('name', ''), 120)
        && isShortText(request.resource.data.get('phone', ''), 40);
    }

    // A new account: always a client with 0 points; referredBy is the friend's
    // referralCode (resolved by the server when points are awarded).
    function validNewUser() {
      return request.resource.data.keys().hasOnly(['role', 'name', 'email', 'phone', 'points', 'referralCode', 'referredBy', 'createdAt', 'updatedAt'])
        && request.resource.data.role == 'client'
        && request.resource.data.points == 0
        && request.resource.data.email == request.auth.token.email.lower()
        && isShortText(request.resource.data.get('name', ''), 120)
        && isShortText(request.resource.data.get('phone', ''), 40)
        && isShortText(request.resource.data.get('referralCode', ''), 40)
        && isShortText(request.resource.data.get('referredBy', ''), 40);
    }

    // The admin (the owner) may read and write everything.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid) && validNewUser();
      allow update: if isSelf(uid) && editableProfileOnly();

      // How each point was earned: read-only to its owner.
      match /points/{eventId} {
        allow read: if isSelf(uid);
      }
    }

    // A client reads their own bookings: linked by uid, or by their verified email.
    match /bookings/{id} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isVerifiedEmail(resource.data.email));
    }

    // Services the owner marked as acquired, read by that client.
    match /acquisitions/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Applications are submitted through api/partner-apply and handled in admin only.
    match /partnerApplications/{id} {
      allow read, write: if false;
    }

    // A partner reads their profile and proposes public changes in pendingProfile,
    // which the owner reviews in admin.
    match /partners/{uid} {
      allow read: if isSelf(uid);
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingProfile', 'updatedAt'])
        && request.resource.data.pendingProfile is map
        && request.resource.data.pendingProfile.size() <= 20;
    }

    // Referrals sent to a partner.
    match /referrals/{id} {
      allow read: if signedIn() && resource.data.partner == request.auth.uid;
    }
  }
}
